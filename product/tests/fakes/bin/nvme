#!/usr/bin/env bash
sub="$1"
case "$sub" in
    id-ctrl)
        if [[ "$2" == "-H" ]]; then
            case "${FAKE_NVME_MODE:-crypto}" in
                crypto)    printf '  [2:2] : 0x1 Crypto Erase Sanitize Operation Supported\n' ;;
                block)     printf '  [2:2] : 0x2 Block Erase Sanitize Operation Supported\n' ;;
                overwrite) printf '  [2:2] : 0x4 Overwrite Sanitize Operation Supported\n' ;;
                format)    printf '  [1:0] : 0x1 Format NVM Supported\n' ;;
                none)      ;;
            esac
        else
            printf 'sn      : SN-NVME-1\n'
            printf 'mn      : NVMe Fake Model\n'
        fi
        ;;
    sanitize-log)
        printf 'SSTAT %s\n' "${FAKE_NVME_SSTAT:-0x1}"
        printf 'SPROG %s\n' "${FAKE_NVME_SPROG:-65535}"
        ;;
    sanitize)
        [[ -n "${FAKE_NVME_SANITIZE_OUT:-}" ]] && printf '%s\n' "$FAKE_NVME_SANITIZE_OUT"
        exit "${FAKE_NVME_SANITIZE_RC:-0}"
        ;;
    format)
        [[ -n "${FAKE_NVME_FORMAT_OUT:-}" ]] && printf '%s\n' "$FAKE_NVME_FORMAT_OUT"
        exit "${FAKE_NVME_FORMAT_RC:-0}"
        ;;
    smart-log)
        printf 'critical_warning                    : %s\n' "${FAKE_NVME_CW:-0}"
        printf 'temperature                         : %s C\n' "${FAKE_NVME_TEMP:-41}"
        printf 'available_spare                     : %s%%\n' "${FAKE_NVME_SPARE:-100}"
        printf 'percentage_used                     : %s%%\n' "${FAKE_NVME_PCT_USED:-12}"
        printf 'data_units_written                  : %s\n' "${FAKE_NVME_DUW:-9876543}"
        printf 'power_cycles                        : %s\n' "${FAKE_NVME_CYCLES:-55}"
        printf 'power_on_hours                      : %s\n' "${FAKE_NVME_POH:-8765}"
        ;;
esac
exit 0
