#!/usr/bin/env bash
if [[ "$1" == "-I" ]]; then
    dev="${2:-}"
    # A real hdparm -I needs a real device path; a missing/empty/bare one fails
    # outright (a test that passes the wrong argument must not be rescued by
    # a default or by a path-less synthetic device).
    if [[ -z "$dev" || ! "$dev" =~ ^/dev/[A-Za-z0-9]+$ ]]; then
        exit 1
    fi
    mode="${FAKE_HDPARM_MODE:-enhanced}"
    if [[ "$mode" == "sas" ]]; then
        # True SAS drive: hdparm -I returns no ATA identify (mirrors the bench
        # AL14SXL30EN behind the HBA330).
        exit 1
    fi
    printf '%s:\n\n' "$dev"
    printf 'ATA device, with non-removable media\n'
    printf '\tModel Number:       %s\n' "${FAKE_HDPARM_MODEL:-FAKE DISK}"
    printf '\tSerial Number:      %s\n' "${FAKE_HDPARM_SERIAL:-S123456789}"
    printf 'Security:\n'
    printf '\tMaster password revision code = 65534\n'
    case "$mode" in
        frozen)
            if [[ -n "${FAKE_HDPARM_UNFREEZE_FILE:-}" && -e "$FAKE_HDPARM_UNFREEZE_FILE" ]]; then
                # The fake rtcwake "unfroze" the drive — report not frozen.
                printf '\t\tsupported\n'
                printf '\tnot\tenabled\n'
                printf '\tnot\tlocked\n'
                printf '\tnot\tfrozen\n'
            else
                printf '\t\tsupported\n'
                printf '\tnot\tenabled\n'
                printf '\tnot\tlocked\n'
                printf '\t\tfrozen\n'
            fi
            ;;
        none)
            printf '\tnot\tsupported\n'
            ;;
        clear)
            printf '\t\tsupported\n'
            printf '\tnot\tenabled\n'
            printf '\tnot\tlocked\n'
            printf '\tnot\tfrozen\n'
            printf '\t120min for SECURITY ERASE UNIT.\n'
            ;;
        clear_notime)
            # Real-drive shape: security supported, enhanced erase NOT
            # supported, and NO "Nmin for SECURITY ERASE UNIT" line (word 89
            # = 0, e.g. old Seagate Momentus 5400.3). Reproduces the bug where
            # this was misclassified CAP_NONE -> FAILED.
            printf '\t\tsupported\n'
            printf '\tnot\tenabled\n'
            printf '\tnot\tlocked\n'
            printf '\tnot\tfrozen\n'
            printf '\tnot\texpired: security count\n'
            printf '\tnot\tsupported: enhanced erase\n'
            ;;
        locked)
            # Security-enabled AND locked at power-on — the real shape after an
            # interrupted erase run. set-pass is refused until an unlock flips
            # the state file (see the --security-unlock handling below).
            if [[ -n "${FAKE_HDPARM_MREV:-}" ]]; then
                printf '\tMaster password revision code = %s\n' "$FAKE_HDPARM_MREV"
            fi
            if [[ -n "${FAKE_HDPARM_STATE_FILE:-}" && -f "$FAKE_HDPARM_STATE_FILE" && "$(<"$FAKE_HDPARM_STATE_FILE")" == unlocked ]]; then
                printf '\t\tsupported\n'
                printf '\t\tenabled\n'
                printf '\tnot\tlocked\n'
            else
                printf '\t\tsupported\n'
                printf '\t\tenabled\n'
                printf '\t\tlocked\n'
            fi
            printf '\tnot\tfrozen\n'
            if [[ "${FAKE_HDPARM_EXPIRED:-0}" == "1" ]]; then
                printf '\t\texpired: security count\n'
            else
                printf '\tnot\texpired: security count\n'
            fi
            printf '\t\tsupported: enhanced erase\n'
            printf '\t214min for SECURITY ERASE UNIT. 216min for ENHANCED SECURITY ERASE UNIT.\n'
            ;;
        *)
            printf '\t\tsupported\n'
            printf '\tnot\tenabled\n'
            printf '\tnot\tlocked\n'
            printf '\tnot\tfrozen\n'
            printf '\t\tsupported: enhanced erase\n'
            printf '\t120min for SECURITY ERASE UNIT.\n'
            printf '\t90min for ENHANCED SECURITY ERASE UNIT.\n'
            ;;
    esac
    # Sanitize feature-set lines (the RSOS path selects its operation from
    # these) — only when the test configures one.
    case "${FAKE_HDPARM_SANITIZE:-none}" in
        crypto)    printf '\t*\tCRYPTO_SCRAMBLE_EXT command\n' ;;
        block)     printf '\t*\tBLOCK_ERASE_EXT command\n' ;;
        overwrite) printf '\t*\tOVERWRITE_EXT command\n' ;;
    esac
    exit 0
fi
# -N (read HPA / max visible sectors). Only emits real output when the test
# configures FAKE_HPA_NATIVE, so the "no hdparm -N output" discovery path in
# test_discover.sh keeps working.
if [[ "$1" == "-N" && "$#" -eq 2 && "$2" != p* ]]; then
    if [[ -n "${FAKE_HPA_NATIVE:-}" ]]; then
        dev="${2:-/dev/sda}"
        state="${FAKE_HPA_STATE:-disabled}"
        # A successful `-N p<count>` reset records the cleared state for re-reads.
        if [[ -n "${FAKE_HPA_STATE_FILE:-}" && -f "$FAKE_HPA_STATE_FILE" ]]; then
            state="$(<"$FAKE_HPA_STATE_FILE")"
        fi
        printf '%s:\n' "$dev"
        printf ' max sectors   = %s/%s, HPA is %s\n' "${FAKE_HPA_CUR:-$FAKE_HPA_NATIVE}" "$FAKE_HPA_NATIVE" "$state"
    fi
    exit 0
fi

# -N p<count> (temporary HPA reset — raise the max visible sectors to native)
if [[ "$1" == "-N" && "$2" == p* ]]; then
    [[ -n "${FAKE_HDPARM_LOG:-}" ]] && printf '%s\n' "-N $2" >> "$FAKE_HDPARM_LOG"
    if [[ "${FAKE_HPA_SET_RC:-0}" == "0" ]]; then
        [[ -n "${FAKE_HPA_STATE_FILE:-}" ]] && printf 'disabled\n' > "$FAKE_HPA_STATE_FILE"
        exit 0
    fi
    exit "${FAKE_HPA_SET_RC}"
fi

# --dco-identify
if [[ "$1" == "--dco-identify" ]]; then
    present="${FAKE_DCO_PRESENT:-0}"
    if [[ -n "${FAKE_DCO_STATE_FILE:-}" && -f "$FAKE_DCO_STATE_FILE" ]]; then
        present="$(<"$FAKE_DCO_STATE_FILE")"
    fi
    if [[ "$present" == "1" ]]; then
        printf 'DCO Revision: 1\n'
    else
        printf 'not supported\n'
    fi
    exit 0
fi

# --dco-restore
if [[ "$1" == "--dco-restore" ]]; then
    [[ -n "${FAKE_HDPARM_LOG:-}" ]] && printf '%s\n' "--dco-restore" >> "$FAKE_HDPARM_LOG"
    if [[ "${FAKE_DCO_RESTORE_RC:-0}" == "0" ]]; then
        [[ -n "${FAKE_DCO_STATE_FILE:-}" ]] && printf '0\n' > "$FAKE_DCO_STATE_FILE"
        exit 0
    fi
    exit "${FAKE_DCO_RESTORE_RC}"
fi

# --user-master u --security-set-pass p | --security-erase(-enhanced) p
if [[ "$1" == "--user-master" ]]; then
    # An expired security count rejects EVERY security command until a power
    # cycle — even correct passwords.
    if [[ "${FAKE_HDPARM_EXPIRED:-0}" == "1" ]]; then
        exit 2
    fi
    case "$3" in
        --security-unlock)
            if [[ "$2" == "m" ]]; then
                # Blank master unlock: allowed only at High level, with the
                # factory revision (or an absent revision line — Intel SSDs
                # omit it once security is enabled) and an empty password.
                if [[ "${FAKE_HDPARM_LEVEL:-high}" == "high" && "${FAKE_HDPARM_MREV:-65534}" == "65534" && "${4:-}" == "" ]]; then
                    [[ -n "${FAKE_HDPARM_STATE_FILE:-}" ]] && printf 'unlocked\n' > "$FAKE_HDPARM_STATE_FILE"
                    exit 0
                fi
                exit 2
            fi
            if [[ -n "${FAKE_HDPARM_USERPW:-}" ]]; then
                # Operator-password model: succeeds ONLY with the configured
                # password; anything else is a failed attempt.
                if [[ "${4:-}" == "$FAKE_HDPARM_USERPW" ]]; then
                    [[ -n "${FAKE_HDPARM_LOG:-}" ]] && printf 'u unlock\n' >> "$FAKE_HDPARM_LOG"
                    [[ -n "${FAKE_HDPARM_STATE_FILE:-}" ]] && printf 'unlocked\n' > "$FAKE_HDPARM_STATE_FILE"
                    exit 0
                fi
                exit 2
            fi
            if [[ "${FAKE_HDPARM_UNLOCK_RC:-0}" == "0" ]]; then
                [[ -n "${FAKE_HDPARM_STATE_FILE:-}" ]] && printf 'unlocked\n' > "$FAKE_HDPARM_STATE_FILE"
                exit 0
            fi
            exit "${FAKE_HDPARM_UNLOCK_RC}"
            ;;
        --security-set-pass)
            [[ -n "${FAKE_HDPARM_LOG:-}" ]] && printf 'u setpass\n' >> "$FAKE_HDPARM_LOG"
            # Real drives: refused while LOCKED; ACCEPTED while unlocked even
            # with a different current password (bench-proven on the Intel —
            # SET PASSWORD replaces the password, it does not compare).
            # FAKE_HDPARM_SETPASS_RC models the drives where it DOES fail
            # unlocked (Maximum-level drives cannot lower the level).
            if [[ "${FAKE_HDPARM_MODE:-enhanced}" == "locked" ]]; then
                # Refused while still locked; succeeds once unlocked.
                if [[ -n "${FAKE_HDPARM_STATE_FILE:-}" && -f "$FAKE_HDPARM_STATE_FILE" && "$(<"$FAKE_HDPARM_STATE_FILE")" == unlocked ]]; then
                    exit "${FAKE_HDPARM_SETPASS_RC:-0}"
                fi
                exit 1
            fi
            exit "${FAKE_HDPARM_SETPASS_RC:-0}"
            ;;
        --security-erase|--security-erase-enhanced)
            [[ -n "${FAKE_HDPARM_LOG:-}" ]] && printf 'u erase\n' >> "$FAKE_HDPARM_LOG"
            if [[ "$2" == "m" ]]; then
                # Blank master erase: allowed only at Maximum level.
                if [[ "${FAKE_HDPARM_LEVEL:-high}" == "maximum" && "${FAKE_HDPARM_MREV:-65534}" == "65534" && "${4:-}" == "" ]]; then
                    exit 0
                fi
                exit 2
            fi
            exit "${FAKE_HDPARM_ERASE_RC:-0}"
            ;;
    esac
fi
exit 0
