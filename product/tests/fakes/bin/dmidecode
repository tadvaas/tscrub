#!/usr/bin/env bash
if [[ "$#" -eq 0 ]]; then
    # Full SMBIOS dump (46_hardware.sh hardware::smbios).
    printf '# SMBIOS 3.4 present.\nHandle 0x0000, DMI type 0, 26 bytes\nBIOS Information\n\tVendor: Fake Inc.\n\tVersion: 1.0\n'
    exit 0
fi
if [[ "$1" == "-t" && "$2" == "24" ]]; then
    # BIOS lock detector (36_bios.sh) reads SMBIOS Type 24. Content driven by
    # the FAKE_DMI24 env var (one line per "… Password Status: <value>").
    printf '%s\n' "${FAKE_DMI24:-}"
    exit 0
fi
if [[ "$1" == "-s" ]]; then
    case "$2" in
        system-manufacturer)   printf 'Fake Inc.\n' ;;
        system-product-name)   printf 'FakeStation\n' ;;
        system-serial-number)  printf 'SYSSN123\n' ;;
        system-uuid)           printf '4C4C4544-0036-5710-8032-B5C04F433633\n' ;;
        baseboard-serial-number) printf 'BBSN123\n' ;;
        chassis-serial-number) printf 'CHSN123\n' ;;
        chassis-type)          printf 'Tower\n' ;;
        bios-version)          printf '1.0\n' ;;
        bios-release-date)     printf '01/01/2024\n' ;;
        *) printf 'N/A\n' ;;
    esac
fi
exit 0
