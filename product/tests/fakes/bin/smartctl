#!/usr/bin/env bash
# Fake smartctl for tests. Emits the health self-assessment line plus a
# synthetic attribute table, driven by FAKE_SMART_* env vars.
mode="${FAKE_SMART_MODE:-pass}"

# The real binary accepts -d <type> anywhere; skip that pair.
if [[ "$1" == "-d" ]]; then
    shift 2
fi

# SATL erase poll seam: while FAKE_SMART_BUSY_FILE holds a counter >0 the
# drive is busy erasing and smartctl FAILS (the real drive answers "Security
# conflict"), decrementing the file each call (env decrements would be lost
# in the child process).
if [[ -n "${FAKE_SMART_BUSY_FILE:-}" && -f "$FAKE_SMART_BUSY_FILE" ]]; then
    n="$(<"$FAKE_SMART_BUSY_FILE")"
    if [[ "${n:-0}" -gt 0 ]]; then
        printf '%s\n' "$((n-1))" > "$FAKE_SMART_BUSY_FILE"
        exit 1
    fi
fi

# Self-test subcommands (for selftest::storage_ata).
case "$1" in
    -t)
        printf 'Self-test initiated\n'
        exit "${FAKE_SMART_T_RC:-0}"
        ;;
    -c)
        printf 'Self-test execution status: ( 0)\tThe previous self-test routine completed without error or no self-test has ever been run.\n'
        exit 0
        ;;
    -l)
        if [[ "$2" == "selftest" ]]; then
            printf 'SMART Self-test log structure revision number 1\n'
            printf 'Num  Test_Description    Status                  Remaining  LifeTime(hours)  LBA_of_first_error\n'
            printf '# 1  Short offline       %s\n' "${FAKE_SMART_SELFTEST:-Completed without error       00%}"
        fi
        if [[ "$2" == "gplog,0x06" || "$2" == "gplog,0x6" ]]; then
            if [[ "${FAKE_SMARTCTL_RSOS:-0}" == "1" ]]; then
                # 512-byte Security log: RSOS = QWord 48..55 bit 7 = byte 48
                # (MSB) = 0x80. Emit 16 hex bytes per dump line.
                l=0; b=0; off=0
                for l in 0 1 2 3; do
                    printf '  %d   0x%04x  ' "$l" "$((l*16))"
                    for b in $(seq 0 15); do
                        off=$((l*16+b))
                        if [[ $off -eq 48 ]]; then printf '80 '; else printf '00 '; fi
                    done
                    printf '\n'
                done
                for l in $(seq 4 31); do
                    printf '  %d   0x%04x  ' "$l" "$((l*16))"
                    printf '00 %.0s' $(seq 1 16)
                    printf '\n'
                done
            else
                printf 'General Purpose Log 0x06 does not exist (override with -T permissive option)\n'
                exit 1
            fi
            exit 0
        fi
        exit 0
        ;;
esac

case "$mode" in
    unsupported)
        printf 'SMART support is: Unavailable - device lacks SMART capability\n'
        exit 0
        ;;
    hang)
        # Busy loop with no child process so kill -9 stops it immediately.
        while :; do :; done
        ;;
    fail)
        printf 'SMART overall-health self-assessment test result: FAILED!\n'
        ;;
    scsi)
        # Native SAS/SCSI: log-page wording, no ATA attribute table.
        printf 'SMART Health Status: %s\n' "${FAKE_SMART_SCSI_HEALTH:-OK}"
        printf 'Current Drive Temperature:     %s C\n' "${FAKE_SMART_TEMP:-49}"
        printf 'Accumulated power on time, hours:minutes %s:%s\n' "${FAKE_SMART_POH:-8711}" "${FAKE_SMART_POH_MIN:-19}"
        printf 'Revision:             %s\n' "${FAKE_SMART_FIRMWARE:-SN01}"
        printf 'Accumulated start-stop cycles:  %s\n' "${FAKE_SMART_CYCLES:-7}"
        printf 'Elements in grown defect list: %s\n' "${FAKE_SMART_GROWN:-4}"
        exit 0
        ;;
    *)
        printf 'SMART overall-health self-assessment test result: PASSED\n'
        ;;
esac

printf 'SMART support is: Available - device has SMART capability.\n'
printf 'SMART Attributes Data Structure revision number: 16\n'
printf 'Vendor Specific SMART Attributes with Thresholds:\n'
printf 'ID# ATTRIBUTE_NAME          FLAG     VALUE WORST THRESH TYPE      UPDATED  WHEN_FAILED RAW_VALUE\n'
printf '  1 Raw_Read_Error_Rate     0x002f   200   200   051    Pre-fail  Always       -       0\n'
printf '  5 Reallocated_Sector_Ct   0x0033   100   100   010    Pre-fail  Always       -       %s\n' "${FAKE_SMART_REALLOC:-0}"
printf '197 Current_Pending_Sector  0x0032   100   100   000    Old_age   Always       -       %s\n' "${FAKE_SMART_PENDING:-0}"
printf '198 Offline_Uncorrectable   0x0030   100   100   000    Old_age   Offline      -       %s\n' "${FAKE_SMART_OFFLINE_UNC:-0}"
printf '199 UDMA_CRC_Error_Count    0x0032   200   200   000    Old_age   Always       -       %s\n' "${FAKE_SMART_UDMA_CRC:-0}"
printf '  9 Power_On_Hours          0x0032   100   100   000    Old_age   Always       -       %s\n' "${FAKE_SMART_POH:-12345}"
printf ' 12 Power_Cycle_Count       0x0032   100   100   000    Old_age   Always       -       %s\n' "${FAKE_SMART_CYCLES:-55}"
printf '194 Temperature_Celsius     0x0022   112   104   000    Old_age   Always       -       %s\n' "${FAKE_SMART_TEMP:-36}"
printf '202 Percent_Lifetime_Remain 0x0031   095   095   000    Old_age   Offline      -       %s\n' "${FAKE_SMART_LIFE_REMAIN:-95}"
printf '241 Total_LBAs_Written      0x0032   100   100   000    Old_age   Always       -       %s\n' "${FAKE_SMART_LBA_WRITTEN:-123456789}"
exit 0
