#!/usr/bin/env bash
# Fake curl for upload_http + mdm tests.
#   - MDM probes (/api/mdm/autopilot) return a scripted verdict (FAKE_MDM_*).
#   - Multipart uploads (the -F flag) return a canned JSON response and log
#     their arguments.
#   - anything else (e.g. license::fetch GETs) delegates to the real curl.

# ---- MDM probe -------------------------------------------------------------
for a in "$@"; do
    if [[ "$a" == *"/api/mdm/autopilot"* ]]; then
        if [[ -n "${FAKE_MDM_CURL_LOG:-}" ]]; then
            { printf 'curl'; printf ' %q' "$@"; printf '\n'; } >> "$FAKE_MDM_CURL_LOG"
        fi
        if [[ "${FAKE_MDM_FAIL_FIRST:-0}" == "1" ]]; then
            flag="${FAKE_MDM_FAIL_FLAG:-${TMPDIR:-/tmp}/tscrub-mdm-curl-ran-$$}"
            if [[ ! -e "$flag" ]]; then
                touch "$flag"
                printf 'curl: (60) SSL certificate problem: certificate has expired\n' >&2
                exit 60
            fi
        fi
        rc="${FAKE_MDM_RC:-0}"
        if [[ "$rc" != "0" ]]; then
            printf 'curl: (7) Failed to connect to host\n' >&2
            exit "$rc"
        fi
        # Stage 1: FAKE_MDM_QUEUE (queued|checking) returns an empty verdict so
        # the appliance polls the status endpoint below.
        if [[ -n "${FAKE_MDM_QUEUE:-}" ]]; then
            case "${FAKE_MDM_QUEUE}" in
                queued)   printf '{"ok":true,"status":"queued","verdict":"","source":"none","label":"Queued"}\n' ;;
                checking) printf '{"ok":true,"status":"checking","verdict":"","source":"none","label":"Checking…"}\n' ;;
                *)        printf '{"ok":true,"status":"%s","verdict":"","source":"none"}\n' "$FAKE_MDM_QUEUE" ;;
            esac
            exit 0
        fi
        case "${FAKE_MDM_VERDICT:-unlocked}" in
            locked_this)  printf '{"ok":true,"status":"done","verdict":"locked_this","source":"live","label":"Locked (this)"}\n' ;;
            locked_other) printf '{"ok":true,"status":"done","verdict":"locked_other","source":"live","label":"Locked"}\n' ;;
            offline)      printf '{"ok":true,"status":"done","verdict":"offline","source":"error","label":"Offline"}\n' ;;
            na)           printf '{"ok":true,"status":"na","verdict":"na","source":"none","label":"---"}\n' ;;
            *)            printf '{"ok":true,"status":"done","verdict":"unlocked","source":"live","label":"Unlocked"}\n' ;;
        esac
        exit 0
    fi
    if [[ "$a" == *"/api/mdm/status"* ]]; then
        if [[ -n "${FAKE_MDM_CURL_LOG:-}" ]]; then
            { printf 'curl'; printf ' %q' "$@"; printf '\n'; } >> "$FAKE_MDM_CURL_LOG"
        fi
        # FAKE_MDM_STATUS_RC simulates the status endpoint becoming unreachable
        # mid-poll (the initial autopilot POST already succeeded).
        if [[ -n "${FAKE_MDM_STATUS_RC:-}" && "${FAKE_MDM_STATUS_RC}" != "0" ]]; then
            printf 'curl: (7) Failed to connect to host\n' >&2
            exit "${FAKE_MDM_STATUS_RC}"
        fi
        # Poll simulation: FAKE_MDM_POLLS = how many "checking" responses to
        # return, then FAKE_MDM_UNKNOWN_POLLS = how many "done + unknown"
        # (Pending) responses, before the terminal verdict. The counter lives
        # in a file (FAKE_MDM_POLL_FILE) because the fake curl runs as a fresh
        # process.
        if [[ -n "${FAKE_MDM_POLL_FILE:-}" ]] && [[ -n "${FAKE_MDM_POLLS:-}${FAKE_MDM_UNKNOWN_POLLS:-}" ]]; then
            n="$(cat "$FAKE_MDM_POLL_FILE" 2>/dev/null || echo 0)"
            checking_polls="${FAKE_MDM_POLLS:-0}"
            unknown_polls="${FAKE_MDM_UNKNOWN_POLLS:-0}"
            if (( n < checking_polls )); then
                echo $((n + 1)) > "$FAKE_MDM_POLL_FILE"
                printf '{"ok":true,"status":"checking","verdict":"","source":"none","label":"Checking…","last_checked_at":null}\n'
                exit 0
            fi
            if (( n < checking_polls + unknown_polls )); then
                echo $((n + 1)) > "$FAKE_MDM_POLL_FILE"
                printf '{"ok":true,"status":"done","verdict":"unknown","source":"live","label":"Pending","last_checked_at":null}\n'
                exit 0
            fi
        fi
        case "${FAKE_MDM_VERDICT:-unlocked}" in
            na)           printf '{"ok":true,"status":"na","verdict":"na","source":"none","label":"---","last_checked_at":null}\n' ;;
            locked_this)  printf '{"ok":true,"status":"done","verdict":"locked_this","source":"live","label":"Locked (this)","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
            locked_other) printf '{"ok":true,"status":"done","verdict":"locked_other","source":"live","label":"Locked","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
            offline)      printf '{"ok":true,"status":"done","verdict":"offline","source":"error","label":"Offline","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
            ms_error)     printf '{"ok":true,"status":"done","verdict":"ms_error","source":"error","label":"MS error","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
            hash_invalid) printf '{"ok":true,"status":"done","verdict":"hash_invalid","source":"error","label":"Invalid hash","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
            *)            printf '{"ok":true,"status":"done","verdict":"unlocked","source":"live","label":"Unlocked","last_checked_at":"2026-09-29T14:11:52Z"}\n' ;;
        esac
        exit 0
    fi
    if [[ "$a" == *"/api/heartbeat"* ]]; then
        if [[ -n "${FAKE_MDM_CURL_LOG:-}" ]]; then
            { printf 'curl'; printf ' %q' "$@"; printf '\n'; } >> "$FAKE_MDM_CURL_LOG"
        fi
        printf '{"ok":true}\n'
        exit 0
    fi
    if [[ "$a" == *"/api/devices/register"* || "$a" == *"/api/reports/diagnostics"* ]]; then
        if [[ -n "${FAKE_MDM_CURL_LOG:-}" ]]; then
            { printf 'curl'; printf ' %q' "$@"; printf '\n'; } >> "$FAKE_MDM_CURL_LOG"
        fi
        printf '{"ok":true,"registered":true,"report_type":"diagnostics"}\n'
        exit 0
    fi
done

upload=0
for a in "$@"; do
    [[ "$a" == "-F" ]] && upload=1
done

if (( upload == 0 )); then
    # Resolve the real curl, skipping this fakes directory.
    IFS=: read -ra _dirs <<< "$PATH"
    for _d in "${_dirs[@]}"; do
        [[ "$_d" == */tests/fakes/bin ]] && continue
        if [[ -x "$_d/curl" ]]; then
            exec "$_d/curl" "$@"
        fi
    done
    echo "curl: command not found" >&2
    exit 127
fi

if [[ -n "${FAKE_CURL_LOG:-}" ]]; then
    printf '%s\n' "$@" >> "$FAKE_CURL_LOG"
fi
if [[ -n "${FAKE_CURL_FAIL:-}" ]]; then
    echo "curl: connection refused" >&2
    exit 7
fi
printf '{"ok":true,"certificates":["COD-000001-XX-YY-0001-ABCD"],"count":2}\n'
exit 0
